        composition=(
            f"{OUT}/review/figures/composition_core_trends_draft.png"
        ),
        prediction=(
            f"{OUT}/review/figures/age_prediction_internal_cv_draft.png"
        ),
        forest=(
            f"{OUT}/review/figures/composition_effect_forest_draft.png"
        ),
        manifest=f"{OUT}/review/draft_asset_manifest.json",
