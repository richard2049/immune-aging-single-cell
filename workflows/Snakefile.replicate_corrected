            "--prediction-out {output.prediction} "
            "--forest-out {output.forest} "
            "--manifest-out {output.manifest} "
            "--record-out {output.record}"
        )


rule pseudobulk_aggregate_corrected:
    input:
        h5ad=CHECKPOINT,
        mapping=MAPPING
    output:
        matrix=f"{PSEUDOBULK}/pseudobulk_counts.mtx.gz",
        profiles=f"{PSEUDOBULK}/pseudobulk_profiles.csv",
        genes=f"{PSEUDOBULK}/pseudobulk_genes.csv",
        eligibility=f"{PSEUDOBULK}/celltype_eligibility.csv",
        audit=f"{PSEUDOBULK}/aggregation_audit.json"
    shell:
        (
            "python -u -m src.pseudobulk_aggregate --config {CFG} "
            "--inp {input.h5ad} --matrix-out {output.matrix} "
            "--profiles-out {output.profiles} --genes-out {output.genes} "
            "--eligibility-out {output.eligibility} "
            "--audit-out {output.audit}"
        )


rule pseudobulk_de_corrected:
    input:
        matrix=f"{PSEUDOBULK}/pseudobulk_counts.mtx.gz",
        profiles=f"{PSEUDOBULK}/pseudobulk_profiles.csv",
        genes=f"{PSEUDOBULK}/pseudobulk_genes.csv",
        audit=f"{PSEUDOBULK}/aggregation_audit.json"
    output:
        combined=f"{PSEUDOBULK}/gene_level_results.csv.gz",
