        (
            "python -m src.age_prediction --config {CFG} --inp {input.h5ad} "
            "--fig-pred {output.fig_pred} --fig-mae {output.fig_mae} "
            "--table-pred {output.table_pred} "
            "--table-metrics {output.table_metrics} "
