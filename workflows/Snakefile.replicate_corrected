        diagnostics=f"{PSEUDOBULK}/design_diagnostics.csv",
        plot=f"{PSEUDOBULK}/edgeR_diagnostic_plots.pdf",
        versions=f"{PSEUDOBULK}/runtime_versions.csv",
        session=f"{PSEUDOBULK}/session_info.txt"
    log:
        f"{PSEUDOBULK}/edgeR.log"
    shell:
        (
            "python -u -m src.run_edger --config {CFG} "
            "--matrix {input.matrix} --profiles {input.profiles} "
            "--genes {input.genes} --combined-out {output.combined} "
            "--celltype-dir {PSEUDOBULK}/by_cell_type "
            "--manifest-out {output.manifest} "
            "--diagnostics-out {output.diagnostics} "
            "--plot-out {output.plot} "
            "--runtime-versions-out {output.versions} "
            "--session-info-out {output.session} "
            "--log-out {log}"
        )


