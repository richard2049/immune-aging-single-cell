        )


rule sensitivity_age_corrected:
    input:
        h5ad=CHECKPOINT,
        mapping=MAPPING
    output:
        manifest=f"{OUT}/sensitivity_age/sensitivity_manifest.csv",
        summary=f"{OUT}/sensitivity_age/sensitivity_summary.csv",
        done=f"{OUT}/sensitivity_age/done.txt"
    shell:
        (
            "python -m src.sensitivity_age --config {CFG} --inp {input.h5ad} "
            "--outdir {OUT}/sensitivity_age --manifest {output.manifest} "
            "--summary {output.summary} --done {output.done}"
        )


rule supplementary_age_corrected:
    input:
        composition=f"{OUT}/tables/age_celltype_trend_stats.csv",
        signature=f"{OUT}/tables/signature_age_associations.csv",
        sensitivity=f"{OUT}/sensitivity_age/sensitivity_manifest.csv"
    output:
        effect=f"{OUT}/figures/supp_age_effect_ci_forest.png",
        stability=f"{OUT}/figures/supp_age_sensitivity_stability.png"
    shell:
        (
            "python -m src.supplementary_age_plots --config {CFG} "
            "--table-composition {input.composition} "
            "--table-signature {input.signature} "
            "--sensitivity-manifest {input.sensitivity} "
            "--fig-effect-ci {output.effect} "
            "--fig-stability {output.stability}"
        )


rule compare_replicate_correction:
    input:
        composition=f"{OUT}/tables/age_celltype_trend_stats.csv",
        signature=f"{OUT}/tables/signature_age_associations.csv",
        prediction=f"{OUT}/tables/age_pred_metrics.csv"
    output:
        associations=f"{OUT}/comparison/association_comparison.csv",
        prediction=f"{OUT}/comparison/age_prediction_comparison.csv",
        summary=f"{OUT}/comparison/summary.json"
    shell:
        (
            "python -m src.compare_replicate_correction "
            "--provisional-out {PROVISIONAL} --corrected-out {OUT} "
            "--association-out {output.associations} "
            "--prediction-out {output.prediction} "
            "--summary-out {output.summary}"
        )


rule validate_replicate_correction:
    input:
        audit=f"{OUT}/tables/biological_replicate_audit.json",
        mapping=MAPPING,
        composition=f"{OUT}/tables/age_celltype_trend_stats.csv",
        signature=f"{OUT}/tables/signature_age_associations.csv",
        predictions=f"{OUT}/tables/age_pred_cv_predictions.csv",
        sensitivity=f"{OUT}/sensitivity_age/sensitivity_manifest.csv",
        comparison=f"{OUT}/comparison/summary.json",
        supplementary=f"{OUT}/figures/supp_age_sensitivity_stability.png"
    output:
        f"{OUT}/validation/replicate_correction_validation.json"
    shell:
        (
            "python -m src.validate_replicate_correction --outdir {OUT} "
            "--report {output}"
        )


rule review_corrected_results:
    input:
        validation=f"{OUT}/validation/replicate_correction_validation.json",
        composition=f"{OUT}/tables/age_celltype_trend_stats.csv",
        fractions=f"{OUT}/tables/age_celltype_fraction_by_donor.csv",
        signature=f"{OUT}/tables/signature_age_associations.csv",
        prediction=f"{OUT}/tables/age_pred_metrics.csv",
        sensitivity=f"{OUT}/sensitivity_age/sensitivity_manifest.csv",
        associations=f"{OUT}/comparison/association_comparison.csv",
        prediction_comparison=f"{OUT}/comparison/age_prediction_comparison.csv",
        dispositions="docs/reviews/corrected_results_dispositions.yml"
    output:
        evidence=f"{OUT}/review/evidence_table.csv",
        summary=f"{OUT}/review/review_summary.json",
        promotion=f"{OUT}/review/promotion_manifest.json",
        report="docs/corrected_results_review.md"
    shell:
        (
            "python -m src.review_corrected_results --config {CFG} "
            "--corrected-out {OUT} --evidence-out {output.evidence} "
            "--summary-out {output.summary} "
            "--promotion-out {output.promotion} "
            "--report-out {output.report}"
        )


rule draft_corrected_public_assets:
    input:
        evidence=f"{OUT}/review/evidence_table.csv",
        fractions=f"{OUT}/tables/age_celltype_fraction_by_donor.csv",
        trends=f"{OUT}/tables/age_celltype_trend_stats.csv",
