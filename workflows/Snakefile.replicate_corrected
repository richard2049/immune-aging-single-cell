rule pseudobulk_robustness_sensitivities:
    input:
        matrix=f"{PSEUDOBULK}/pseudobulk_counts.mtx.gz",
        profiles=f"{PSEUDOBULK}/pseudobulk_profiles.csv",
        genes=f"{PSEUDOBULK}/pseudobulk_genes.csv",
        primary=f"{PSEUDOBULK}/gene_level_results.csv.gz",
        validation=f"{PSEUDOBULK}/technical_validation.json"
    output:
        sensitivity=f"{PSEUDOBULK_ROBUSTNESS}/sensitivity_gene_results.csv.gz",
        diagnostics=f"{PSEUDOBULK_ROBUSTNESS}/scenario_diagnostics.csv",
        manifest=f"{PSEUDOBULK_ROBUSTNESS}/scenario_manifest.csv"
    log:
        f"{PSEUDOBULK_ROBUSTNESS}/edgeR_robustness.log"
    shell:
        (
            "python -u -m src.run_pseudobulk_robustness --config {CFG} "
            "--matrix {input.matrix} --profiles {input.profiles} "
            "--genes {input.genes} --primary-results {input.primary} "
            "--sensitivity-out {output.sensitivity} "
            "--diagnostics-out {output.diagnostics} "
            "--manifest-out {output.manifest} --log-out {log}"
        )


rule pseudobulk_robustness_evidence:
    input:
        sensitivity=f"{PSEUDOBULK_ROBUSTNESS}/sensitivity_gene_results.csv.gz",
        diagnostics=f"{PSEUDOBULK_ROBUSTNESS}/scenario_diagnostics.csv",
        manifest=f"{PSEUDOBULK_ROBUSTNESS}/scenario_manifest.csv",
        primary=f"{PSEUDOBULK}/gene_level_results.csv.gz",
        profiles=f"{PSEUDOBULK}/pseudobulk_profiles.csv",
        reference_diagnostics=f"{PSEUDOBULK}/design_diagnostics.csv",
        validation=f"{PSEUDOBULK}/technical_validation.json",
        diagnostic_review="docs/reviews/pseudobulk_diagnostic_plot_review.yml"
    output:
        evidence=f"{PSEUDOBULK_ROBUSTNESS}/candidate_evidence.csv.gz",
        queue=f"{PSEUDOBULK_ROBUSTNESS}/review_queue.csv",
        celltypes=f"{PSEUDOBULK_ROBUSTNESS}/celltype_robustness_summary.csv",
        summary=f"{PSEUDOBULK_ROBUSTNESS}/audit_summary.json",
        report="docs/pseudobulk_robustness_audit.md"
    shell:
        (
            "python -m src.prepare_pseudobulk_evidence --config {CFG} "
            "--pseudobulk-dir {PSEUDOBULK} --report-out {output.report}"
        )
