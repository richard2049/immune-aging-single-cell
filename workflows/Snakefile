OUT = config["project"]["out_dir"]
CFG = config["cfg_path"]
SENS_AGE_ENABLED = bool(config.get("sensitivity_age", {}).get("enabled", False))
SENS_AGE_MANIFEST = f"{OUT}/sensitivity_age/sensitivity_manifest.csv"
SENS_AGE_OUTPUTS = (
    [
        SENS_AGE_MANIFEST,
        f"{OUT}/sensitivity_age/sensitivity_summary.csv",
        f"{OUT}/sensitivity_age/done.txt",
    ]
    if SENS_AGE_ENABLED
    else []
)
SUPP_SENS_INPUT = [SENS_AGE_MANIFEST] if SENS_AGE_ENABLED else []
SUPP_AGE_OUTPUTS = [
    f"{OUT}/figures/supp_age_effect_ci_forest.png",
    f"{OUT}/figures/supp_age_sensitivity_stability.png",
]

rule all:
    input:
        [
            f"{OUT}/reports.done",
            f"{OUT}/figures/age_celltype_composition_by_bin.png",
            f"{OUT}/figures/age_celltype_top_trends.png",
            f"{OUT}/tables/age_celltype_fraction_by_donor.csv",
            f"{OUT}/tables/age_celltype_trend_stats.csv",
            f"{OUT}/figures/signature_age_heatmap.png",
            f"{OUT}/figures/signature_age_top_associations.png",
            f"{OUT}/tables/signature_scores_by_donor_celltype.csv",
            f"{OUT}/tables/signature_age_associations.csv",
            f"{OUT}/figures/age_pred_observed_vs_predicted.png",
            f"{OUT}/figures/age_pred_mae_by_celltype.png",
            f"{OUT}/tables/age_pred_cv_predictions.csv",
            f"{OUT}/tables/age_pred_metrics.csv",
            f"{OUT}/tables/age_pred_model_comparison_summary.csv",
        ]
        + SUPP_AGE_OUTPUTS
        + SENS_AGE_OUTPUTS

rule ingest:
    output:
        f"{OUT}/01_raw.h5ad"
    shell:
        "python -m src.ingest --config {CFG} --out {output}"

rule metadata:
    input:
        f"{OUT}/01_raw.h5ad"
    output:
        f"{OUT}/01_meta.h5ad"
    shell:
        "python -m src.metadata_integrate --config {CFG} --inp {input} --out {output}"

rule qc:
    input:
        f"{OUT}/01_meta.h5ad"
    output:
        f"{OUT}/02_qc.h5ad"
    shell:
        "python -m src.qc --config {CFG} --inp {input} --out {output}"

rule doublets:
    input:
        f"{OUT}/02_qc.h5ad"
    output:
        f"{OUT}/03_nodoublets.h5ad"
    shell:
        "python -m src.doublets_solo --config {CFG} --inp {input} --out {output}"

rule scvi_train:
    input:
        f"{OUT}/03_nodoublets.h5ad"
    output:
        f"{OUT}/04_scvi.h5ad"
    shell:
        "python -m src.scvi_train --config {CFG} --inp {input} --out {output}"

rule cluster:
    input:
        f"{OUT}/04_scvi.h5ad"
    output:
        f"{OUT}/05_clustered.h5ad"
    shell:
        "python -m src.cluster --config {CFG} --inp {input} --out {output}"

rule annotate:
    input:
        f"{OUT}/05_clustered.h5ad"
    output:
        f"{OUT}/06_annotated.h5ad"
    shell:
        "python -m src.annotate_celltypist --config {CFG} --inp {input} --out {output}"

rule report:
    input:
        f"{OUT}/06_annotated.h5ad"
    output:
        done=f"{OUT}/reports.done",
        umap_leiden=f"{OUT}/figures/umap_leiden.png",
        umap_cell_type=f"{OUT}/figures/umap_cell_type.png",
        qc_distributions=f"{OUT}/figures/qc_distributions.png",
        cell_type_composition=f"{OUT}/figures/cell_type_composition.png",
        cell_type_counts=f"{OUT}/tables/cell_type_counts.csv",
        cell_type_fractions=f"{OUT}/tables/cell_type_fractions.csv",
        cluster_celltype_crosstab=f"{OUT}/tables/cluster_celltype_crosstab.csv"
    shell:
        (
            "python -m src.report --config {CFG} --inp {input} "
            "--figdir {OUT}/figures --tabledir {OUT}/tables --done {output.done}"
        )


rule composition_age:
    input:
        f"{OUT}/06_annotated.h5ad"
    output:
        fig_composition=f"{OUT}/figures/age_celltype_composition_by_bin.png",
        fig_trends=f"{OUT}/figures/age_celltype_top_trends.png",
        table_fraction=f"{OUT}/tables/age_celltype_fraction_by_donor.csv",
        table_trends=f"{OUT}/tables/age_celltype_trend_stats.csv"
    shell:
        (
            "python -m src.composition_age --config {CFG} --inp {input} "
            "--fig-fractions {output.fig_composition} --fig-trends {output.fig_trends} "
            "--table-donor-fractions {output.table_fraction} --table-trends {output.table_trends}"
        )


rule signature_age:
    input:
        f"{OUT}/06_annotated.h5ad"
    output:
        fig_heatmap=f"{OUT}/figures/signature_age_heatmap.png",
        fig_top=f"{OUT}/figures/signature_age_top_associations.png",
        table_scores=f"{OUT}/tables/signature_scores_by_donor_celltype.csv",
        table_assoc=f"{OUT}/tables/signature_age_associations.csv",
        table_sigmeta=f"{OUT}/tables/signature_gene_coverage.csv"
    shell:
        (
            "python -m src.signature_age --config {CFG} --inp {input} "
            "--fig-heatmap {output.fig_heatmap} --fig-top {output.fig_top} "
            "--table-scores {output.table_scores} --table-assoc {output.table_assoc} "
            "--table-signature-meta {output.table_sigmeta}"
        )


rule age_prediction:
    input:
        f"{OUT}/06_annotated.h5ad"
    output:
        fig_pred=f"{OUT}/figures/age_pred_observed_vs_predicted.png",
        fig_mae=f"{OUT}/figures/age_pred_mae_by_celltype.png",
        table_pred=f"{OUT}/tables/age_pred_cv_predictions.csv",
        table_metrics=f"{OUT}/tables/age_pred_metrics.csv",
        table_summary=f"{OUT}/tables/age_pred_model_comparison_summary.csv"
    shell:
        (
            "python -m src.age_prediction --config {CFG} --inp {input} "
            "--fig-pred {output.fig_pred} --fig-mae {output.fig_mae} "
            "--table-pred {output.table_pred} --table-metrics {output.table_metrics} "
            "--table-summary {output.table_summary}"
        )


rule sensitivity_age:
    input:
        f"{OUT}/06_annotated.h5ad"
    output:
        manifest=f"{OUT}/sensitivity_age/sensitivity_manifest.csv",
        summary=f"{OUT}/sensitivity_age/sensitivity_summary.csv",
        done=f"{OUT}/sensitivity_age/done.txt"
    shell:
        (
            "python -m src.sensitivity_age --config {CFG} --inp {input} "
            "--outdir {OUT}/sensitivity_age --manifest {output.manifest} "
            "--summary {output.summary} --done {output.done}"
        )


rule supplementary_age:
    input:
        table_composition=f"{OUT}/tables/age_celltype_trend_stats.csv",
        table_signature=f"{OUT}/tables/signature_age_associations.csv",
        sens=SUPP_SENS_INPUT
    output:
        fig_effect_ci=f"{OUT}/figures/supp_age_effect_ci_forest.png",
        fig_stability=f"{OUT}/figures/supp_age_sensitivity_stability.png"
    shell:
        (
            "python -m src.supplementary_age_plots --config {CFG} "
            "--table-composition {input.table_composition} "
            "--table-signature {input.table_signature} "
            "--sensitivity-manifest " + SENS_AGE_MANIFEST + " "
            "--fig-effect-ci {output.fig_effect_ci} "
            "--fig-stability {output.fig_stability}"
        )
